<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">
  <Id>1cfaa211-2dcc-4e68-80a2-7a79219462ab</Id>
  <Version>0.0.1</Version>
  <ProviderName>Ledger</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Ledger" />
  <Description DefaultValue="Autonomous Excel engineering agent: workbook intelligence, deterministic audit, reviewed change sets." />
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://github.com/pparekh088/Excel-plugin" />
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.7" />
      <!-- Shared runtime: one JS context for task pane, commands and custom
           functions, so AI.* can use the task pane's token (P1-6). -->
      <Set Name="SharedRuntime" MinVersion="1.1" />
    </Sets>
  </Requirements>
  <!--
    WebApplicationInfo declares the add-in's Entra registration so the host can
    broker tokens for it (NAA). Id is the add-in SPA registration; Resource is
    the API registration the backend validates as its audience. Both are
    placeholders until the pilot tenant's real IDs are issued (D-006) — the
    build substitutes them from LEDGER_ENTRA_* at package time.
  -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <!--
          SHARED RUNTIME. The task pane, the ribbon commands and the AI.*
          custom functions all run in ONE JavaScript context, pointed at the
          task pane page.

          This is not a performance choice. Custom functions must send a bearer
          token, and acquiring one is an interactive flow that belongs to the
          task pane. In separate runtimes the functions runtime has no access
          to the task pane's token cache and no way to run that flow, so every
          AI.* cell would fail against an authenticated backend. A shared
          runtime gives them the same module instance and therefore the same
          cached token (P1-6).

          Requires the SharedRuntime 1.1 requirement set below; on hosts
          without it the add-in falls back to separate runtimes and AI.*
          functions only work against a dev-mode backend.
        -->
        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long" />
        </Runtimes>
        <AllFormFactors>
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script>
              <SourceLocation resid="Functions.Script.Url" />
            </Script>
            <Page>
              <SourceLocation resid="Taskpane.Url" />
            </Page>
            <Metadata>
              <SourceLocation resid="Functions.Metadata.Url" />
            </Metadata>
            <Namespace resid="Functions.Namespace" />
          </ExtensionPoint>
        </AllFormFactors>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Ledger.Group">
                <Label resid="Group.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16" />
                  <bt:Image size="32" resid="Icon.32" />
                  <bt:Image size="80" resid="Icon.80" />
                </Icon>
                <Control xsi:type="Button" id="Ledger.TaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Ledger.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://localhost:3000/assets/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://localhost:3000/assets/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://localhost:3000/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html" />
        <bt:Url id="Functions.Script.Url" DefaultValue="https://localhost:3000/functions.js" />
        <bt:Url id="Functions.Page.Url" DefaultValue="https://localhost:3000/functions.html" />
        <bt:Url id="Functions.Metadata.Url" DefaultValue="https://localhost:3000/functions.json" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/pparekh088/Excel-plugin" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Ledger loaded" />
        <bt:String id="Group.Label" DefaultValue="Ledger" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Open Ledger" />
        <bt:String id="Functions.Namespace" DefaultValue="AI" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open the Ledger task pane from the Home tab." />
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the Ledger task pane" />
      </bt:LongStrings>
    </Resources>
    <WebApplicationInfo>
      <Id>00000000-0000-0000-0000-000000000000</Id>
      <Resource>api://localhost:8000/00000000-0000-0000-0000-000000000000</Resource>
      <Scopes>
        <Scope>openid</Scope>
        <Scope>profile</Scope>
        <Scope>access</Scope>
      </Scopes>
    </WebApplicationInfo>
  </VersionOverrides>
</OfficeApp>
