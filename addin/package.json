{
  "name": "ledger-addin",
  "version": "0.0.1",
  "private": true,
  "description": "Ledger - autonomous Excel engineering agent (Office.js add-in)",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start:desktop": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schemas": "tsx scripts/export-schemas.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/office-js": "^1.0.400",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-debugging": "^5.1.5",
    "office-addin-dev-certs": "^1.13.3",
    "office-addin-manifest": "^1.13.6",
    "ts-loader": "^9.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
