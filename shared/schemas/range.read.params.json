{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sheet": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Worksheet name exactly as shown on the tab"
    },
    "a1": {
      "type": "string",
      "pattern": "^(\\$?[A-Za-z]{1,3}\\$?[1-9][0-9]{0,6}(:\\$?[A-Za-z]{1,3}\\$?[1-9][0-9]{0,6})?|\\$?[A-Za-z]{1,3}:\\$?[A-Za-z]{1,3}|\\$?[1-9][0-9]{0,6}:\\$?[1-9][0-9]{0,6})$",
      "description": "A1-style range without sheet qualifier, e.g. B2:D500"
    },
    "include": {
      "default": [
        "values"
      ],
      "description": "Which layers to read; formulas are en-US ('formulas', never 'formulasLocal')",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "values",
          "formulas",
          "numberFormats"
        ]
      }
    },
    "maxCells": {
      "description": "Refuse the read if the range exceeds this many cells (default 100000)",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 200000
    }
  },
  "required": [
    "sheet",
    "a1"
  ],
  "additionalProperties": false
}
