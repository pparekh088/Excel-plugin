{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sheet": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Worksheet name exactly as shown on the tab"
    },
    "a1": {
      "type": "string",
      "description": "Normalized absolute address as reported by Excel, e.g. Sheet1!A1:D10"
    },
    "rowCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "columnCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cellCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "chunkCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Number of chunked syncs used (INV-5)"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "formulas": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "numberFormats": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "sheet",
    "a1",
    "rowCount",
    "columnCount",
    "cellCount",
    "chunkCount"
  ],
  "additionalProperties": false
}
